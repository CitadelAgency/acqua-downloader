{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acqua Downloader",
  "mainBinaryName": "acqua",
  "version": "2.1.1",
  "identifier": "com.dlm.app",
  "build": { "frontendDist": "frontend/dist", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:5173", "beforeDevCommand": "npm run dev" },
  "app": { "windows": [], "withGlobalTauri": true, "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "extension/icons/icon128.png"],
    "license": "MIT",
    "shortDescription": "Segmented download manager",
    "resources": { "extension/": "extension/", "LICENSE": "LICENSE", "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt" },
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
