{
  "manifest_version": 3,
  "name": "dlm — gerenciador de downloads",
  "short_name": "dlm",
  "version": "1.0.0",
  "description": "Envia downloads grandes para o dlm, que baixa em várias conexões e nunca entrega arquivo corrompido.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "cookies", "nativeMessaging", "storage", "notifications", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "dlm", "default_popup": "options.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
